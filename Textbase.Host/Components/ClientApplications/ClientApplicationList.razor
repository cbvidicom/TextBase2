@page "/client-applications"

@using Textbase.Application.Features.ClientApplications
@using Textbase.Host.ViewModels.ClientApplications

@inherits TextbaseDataGridViewBase<ClientApplicationListViewModel, ClientApplication, ClientApplicationFilter>

@if (!IsInitialized)
{
	<RzLoadingIndicator IndicatorVariant="IndicatorVariant.Table" />
}
else if (HasAccess)
{
	<RzDataGrid @ref="Grid"
				TItem="ClientApplication"
				AllowFiltering="true"
				AllowPaging="true"
				AllowSorting="true"
				Count="@ViewModel.ItemCount"
				Data="@ViewModel.Data"
				IsLoading="@IsBusy"
				PageSize="@ViewModel.PageSize"
				SelectionMode="DataGridSelectionMode.Single"
				LoadData="ViewModel.LoadDataAsync"
				RowRender="OnRowRender"
				RowSelect="OnRowSelect"
				class="rz-mb-4">
		<Columns>
			<RadzenDataGridColumn Filterable="true"
								  Frozen="true"
								  Property="@nameof(ClientApplication.Name)"
								  Sortable="true"
								  SortOrder="SortOrder.Ascending"
								  Title="Name" />
			<RadzenDataGridColumn Filterable="true"
								  Property="@nameof(ClientApplication.DefaultLanguageTag)"
								  Sortable="true"
								  Title="Tag" />
			<RadzenDataGridColumn Filterable="true"
								  Property="@nameof(ClientApplication.DefaultFileName)"
								  Sortable="true"
								  Title="File" />
			<RadzenDataGridColumn Filterable="false"
								  Property="@nameof(ClientApplication.IsActive)"
								  Sortable="true"
								  Title="Active" />
			<RadzenDataGridColumn Filterable="false"
								  Sortable="false"
								  Title="Locales">
				<Template Context="clientApplication">
					@ViewModel.GetLocaleCount(clientApplication.ClientApplicationGuid)
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn Filterable="false"
								  Sortable="false"
								  Title="Texts">
				<Template Context="clientApplication">
					@ViewModel.GetTextResourceCount(clientApplication.ClientApplicationGuid)
				</Template>
			</RadzenDataGridColumn>
		</Columns>
	</RzDataGrid>
}

@if (HasAccess && ViewModel.CreateAuthorization.IsAllowed)
{
	<RzAddButton Path="@StaticRoutes.ClientApplicationCreate" />
}

@code {
	public override string MainHeader => "Applications";

	protected override string EditItemRouteTemplate => StaticRoutes.ClientApplicationEdit;

	protected override Func<ClientApplication, object> GetKey => e => e.ClientApplicationGuid;
}
