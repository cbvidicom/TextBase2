@page "/formality"
@page "/formality/{Key}"

@using Textbase.Application.Features.Formalities
@using Textbase.Host.ViewModels.Formalities

@inherits TextbaseStringEditorViewBase<FormalityEditorViewModel, FormalityDto, Formality, FormalityFilter>

@if (CanGoBack)
{
	<RzGoBackLink Path="@GoBackPath" />
}

@if (IsBusy)
{
	<RzLoadingIndicator IndicatorVariant="IndicatorVariant.Form" />
}
else if (HasAccess)
{
	<RadzenTemplateForm TItem="Formality"
						Data="@Item"
						class="rz-mt-4 rz-mb-4">
		<AntiforgeryToken />
		<DataAnnotationsValidator />
		<fieldset disabled="@IsReadOnly">
			<VerticalStack>
				<RzTextBoxFormField MinLength="1"
									 MaxLength="16"
									 Name="@nameof(Formality.FormalityKey)"
									 ReadOnly="@(!IsNewItem)"
									 Required="true"
									 StartIcon="@Icons.Name"
									 Text="Key"
									 @bind-Value="@Item.FormalityKey" />
				<RzTextAreaFormField MaxLength="1024"
									 Name="@nameof(Formality.Description)"
									 StartIcon="@Icons.Description"
									 Text="Description"
									 @bind-Value="@Item.Description" />

				@if (CanSave)
				{
					<HorizontalStack>
						<RzSaveButton RenderStack="false"
									  Click="OnSave" />
						@if (CanGoBack)
						{
							<RzClickButton ButtonStyle="ButtonStyle.Secondary"
										   Click="OnSaveAndGoBack"
										   Icon="@Icons.Save"
										   RenderStack="false"
										   Text="Save & Go back" />
						}
						@if (CanNew)
						{
							<RzClickButton ButtonStyle="ButtonStyle.Info"
										   Click="OnSaveAndNew"
										   Icon="@Icons.Save"
										   RenderStack="false"
										   Text="Save & New" />
						}
					</HorizontalStack>
				}
			</VerticalStack>
		</fieldset>

		@if (CanDelete)
		{
			<RzDeleteButton Click="OnDelete" />
		}
	</RadzenTemplateForm>
}

@code {
	public override string MainHeader => IsNewItem ? "Create Formality" : "Edit Formality";

	protected override string GoBackPath => StaticRoutes.FormalityList;

	protected override string CreatePath => StaticRoutes.FormalityCreate;
}
