@page "/translation"
@page "/translation/{LocaleKey}/{TextKey}/{FormalityKey}/{PresentationKey}"

@using Textbase.Application.Features.Translations
@using Textbase.Host.ViewModels.Translations

@inject TranslationEditorViewModel ViewModel

@if (_canGoBack)
{
	<RzGoBackLink Path="@StaticRoutes.TranslationList" />
}

@if (_isBusy)
{
	<RzLoadingIndicator IndicatorVariant="IndicatorVariant.Form" />
}
else if (ViewModel.HasAccess && ViewModel.Item is not null)
{
	<RadzenTemplateForm TItem="Translation"
						Data="@ViewModel.Item"
						class="rz-mt-4 rz-mb-4">
		<AntiforgeryToken />
		<DataAnnotationsValidator />
		<fieldset disabled="@ViewModel.IsReadOnly">
			<VerticalStack>
				@if (ViewModel.IsNewItem)
				{
					<RzDropDownFormField TValue="string"
										 AllowClear="false"
										 AllowFiltering="true"
										 Data="@ViewModel.LocaleKeys"
										 FilterAsYouType="true"
										 FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
										 Name="@nameof(Translation.LocaleKey)"
										 Required="true"
										 StartIcon="@Icons.Language"
										 Text="Locale"
										 @bind-Value="@ViewModel.Item.LocaleKey" />
					@if (!String.IsNullOrWhiteSpace(ViewModel.GetParentLocaleKey(ViewModel.Item.LocaleKey)))
					{
						<RzClickButton ButtonStyle="ButtonStyle.Secondary"
										   Click="ViewModel.SelectParentLocale"
										   RenderStack="false"
										   Text="Select parent" />
					}
					<RzDropDownFormField TValue="string"
										 AllowClear="false"
										 AllowFiltering="true"
										 Data="@ViewModel.TextKeys"
										 FilterAsYouType="true"
										 FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
										 Name="@nameof(Translation.TextKey)"
										 Required="true"
										 StartIcon="@Icons.Description"
										 Text="Text"
										 @bind-Value="@ViewModel.Item.TextKey" />
					<RzDropDownFormField TValue="string"
										 AllowClear="false"
										 AllowFiltering="true"
										 Data="@ViewModel.FormalityKeys"
										 FilterAsYouType="true"
										 FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
										 Name="@nameof(Translation.FormalityKey)"
										 Required="true"
										 StartIcon="@Icons._3p"
										 Text="Formality"
										 @bind-Value="@ViewModel.Item.FormalityKey" />
					<RzDropDownFormField TValue="string"
										 AllowClear="false"
										 AllowFiltering="true"
										 Data="@ViewModel.PresentationKeys"
										 FilterAsYouType="true"
										 FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
										 Name="@nameof(Translation.PresentationKey)"
										 Required="true"
										 StartIcon="@Icons.ShortText"
										 Text="Presentation"
										 @bind-Value="@ViewModel.Item.PresentationKey" />
				}
				else
				{
					<RzTextBoxFormField Name="@nameof(Translation.LocaleKey)"
										ReadOnly="true"
										StartIcon="@Icons.Language"
										Text="Locale"
										Value="@ViewModel.Item.LocaleKey" />
					<RzTextBoxFormField Name="@nameof(Translation.TextKey)"
										ReadOnly="true"
										StartIcon="@Icons.Description"
										Text="Text"
										Value="@ViewModel.Item.TextKey" />
					<RzTextBoxFormField Name="@nameof(Translation.FormalityKey)"
										ReadOnly="true"
										StartIcon="@Icons._3p"
										Text="Formality"
										Value="@ViewModel.Item.FormalityKey" />
					<RzTextBoxFormField Name="@nameof(Translation.PresentationKey)"
										ReadOnly="true"
										StartIcon="@Icons.ShortText"
										Text="Presentation"
										Value="@ViewModel.Item.PresentationKey" />
				}

				<RzTextAreaFormField Name="@nameof(Translation.Value)"
									 Required="true"
									 StartIcon="@Icons.Description"
									 Text="Value"
									 @bind-Value="@ViewModel.Item.Value" />

				@if (ViewModel.CanSave || ViewModel.CanDelete)
				{
					<HorizontalStack>
						@if (ViewModel.CanSave)
						{
							<RzSaveButton RenderStack="false"
											  Click="OnSave" />
							<RzClickButton ButtonStyle="ButtonStyle.Secondary"
										   Click="OnSaveAndGoBack"
										   Icon="@Icons.Save"
										   RenderStack="false"
										   Text="Save & Go back" />
							@if (ViewModel.IsNewItem)
							{
								<RzClickButton ButtonStyle="ButtonStyle.Info"
											   Click="OnSaveAndNew"
											   Icon="@Icons.Save"
											   RenderStack="false"
											   Text="Save & New" />
							}
						}
						@if (ViewModel.CanDelete)
						{
							<RzDeleteButton Click="OnDelete" />
						}
					</HorizontalStack>
				}
			</VerticalStack>
		</fieldset>
	</RadzenTemplateForm>
}

@code {
	[CascadingParameter]
	private MainLayout MainLayout { get; set; } = default!;

	[Parameter]
	public string? LocaleKey { get; set; }

	[Parameter]
	public string? TextKey { get; set; }

	[Parameter]
	public string? FormalityKey { get; set; }

	[Parameter]
	public string? PresentationKey { get; set; }

	[SupplyParameterFromQuery(Name = "localeKey")]
	public string? InitialLocaleKey { get; set; }

	[SupplyParameterFromQuery(Name = "textKey")]
	public string? InitialTextKey { get; set; }

	private bool _isBusy = true;
	private bool _canGoBack = true;

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
		_isBusy = true;

		try
		{
			await ViewModel.InitializeAsync(LocaleKey, TextKey, FormalityKey, PresentationKey, InitialLocaleKey, InitialTextKey);
		}
		catch (Exception ex)
		{
			AlertService.Show(ex);
		}
		finally
		{
			TextbaseViewHelper.Initialize(MainLayout, ViewModel.IsNewItem ? "Create Translation" : "Edit Translation", ViewModel.HasAccess, ViewModel.AccessDeniedMessage);
			_isBusy = false;
		}
	}

	private Task OnSave()
		=> SaveAsync(false, false);

	private Task OnSaveAndGoBack()
		=> SaveAsync(true, false);

	private Task OnSaveAndNew()
		=> SaveAsync(false, true);

	private async Task SaveAsync(
		bool goBack,
		bool createNew)
	{
		if (ViewModel.Item is null || !HasValidKey(ViewModel.Item))
		{
			return;
		}

		_isBusy = true;
		try
		{
			bool wasNewItem = ViewModel.IsNewItem;
			await ViewModel.SaveAsync();

			if (goBack)
			{
				NavigationManager.NavigateTo(StaticRoutes.TranslationList);
				return;
			}

			if (createNew)
			{
				await ViewModel.CreateNewItemAsync(InitialLocaleKey, InitialTextKey);
				return;
			}

			if (wasNewItem)
			{
				NavigationManager.NavigateTo(GetEditRoute(ViewModel.Item));
			}
			else
			{
				await ViewModel.RefreshDeleteAuthorizationAsync();
			}
		}
		catch (Exception ex)
		{
			AlertService.Show(ex);
		}
		finally
		{
			_isBusy = false;
		}
	}

	private async Task OnDelete()
	{
		if (ViewModel.Item is null || ViewModel.IsNewItem)
		{
			return;
		}

		bool? confirmed = await DialogService.Confirm("Are you sure you want to delete this Translation?", "Delete Translation");
		if (confirmed != true)
		{
			return;
		}

		_isBusy = true;
		try
		{
			await ViewModel.DeleteAsync();
			if (!ViewModel.CanDelete)
			{
				return;
			}

			NavigationManager.NavigateTo(StaticRoutes.TranslationList);
		}
		catch (Exception ex)
		{
			AlertService.Show(ex);
		}
		finally
		{
			_isBusy = false;
		}
	}

	private static bool HasValidKey(
		Translation translation)
		=> !String.IsNullOrWhiteSpace(translation.LocaleKey) &&
			!String.IsNullOrWhiteSpace(translation.TextKey) &&
			!String.IsNullOrWhiteSpace(translation.FormalityKey) &&
			!String.IsNullOrWhiteSpace(translation.PresentationKey);

	private static string GetEditRoute(
		Translation translation)
		=> String.Format(StaticRoutes.TranslationEdit, String.Join('/',
			Uri.EscapeDataString(translation.LocaleKey),
			Uri.EscapeDataString(translation.TextKey),
			Uri.EscapeDataString(translation.FormalityKey),
			Uri.EscapeDataString(translation.PresentationKey)));
}
