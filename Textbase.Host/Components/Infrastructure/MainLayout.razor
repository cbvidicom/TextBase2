@inherits LayoutComponentBase
@implements IDisposable

<CascadingValue Value="this">
	<RadzenLayout>
		<RadzenHeader>
			<RadzenStack AlignItems="AlignItems.Center"
						 Gap="0"
						 Orientation="Orientation.Horizontal">
				<RadzenSidebarToggle Click="@(() => _isSidebarExpanded = !_isSidebarExpanded)" />
				<RadzenLabel Text="@_header" />
			</RadzenStack>
		</RadzenHeader>
		<RadzenSidebar FullHeight="true"
					   @bind-Expanded="@_isSidebarExpanded">
			<RadzenPanelMenu>
				<RadzenPanelMenuItem Icon="@Icons.Home"
									 Path="@StaticRoutes.Home"
									 Text="Home" />
				<RadzenPanelMenuItem Icon="@Icons.Apps"
									 Path="@StaticRoutes.ClientApplicationList"
									 Text="Applications" />
			</RadzenPanelMenu>
		</RadzenSidebar>
		<RadzenBody>
			<div class="rz-p-4">
				@Body
			</div>
		</RadzenBody>
	</RadzenLayout>
</CascadingValue>

@if (AlertService.IsVisible)
{
	<RadzenAlert AlertStyle="@AlertService.AlertStyle"
				 AllowClose="@AlertService.AllowClose"
				 Size="@AlertService.Size"
				 Title="@AlertService.Title"
				 Variant="@AlertService.Variant"
				 Close="OnAlertClose">
		@((MarkupString)AlertService.HtmlFormattedText)
	</RadzenAlert>
}

<RadzenDialog />

<div id="blazor-error-ui" data-nosnippet>
	An unhandled error has occurred.
	<a href="." class="reload">Reload</a>
	<span class="dismiss">🗙</span>
</div>

@code {
	private string _header = String.Empty;
	private bool _isSidebarExpanded = true;

	protected override void OnInitialized()
	{
		base.OnInitialized();

		_header = GetDefaultHeader(NavigationManager.Uri);
		NavigationManager.LocationChanged += OnLocationChanged;
	}

	public void SetHeader(
		string header)
	{
		if (_header == header)
			return;

		_header = header;
		_ = InvokeAsync(StateHasChanged);
	}

	public void Dispose()
		=> NavigationManager.LocationChanged -= OnLocationChanged;

	private void OnAlertClose(
		dynamic _)
		=> AlertService.Hide();

	private void OnLocationChanged(
		object? sender,
		LocationChangedEventArgs args)
		=> SetHeader(GetDefaultHeader(args.Location));

	private string GetDefaultHeader(
		string location)
	{
		string path = NavigationManager.ToBaseRelativePath(location);
		int suffixIndex = path.IndexOfAny(['?', '#']);
		if (suffixIndex >= 0)
			path = path[..suffixIndex];

		string segment = path.Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "home";
		string[] words = segment.Split('-', StringSplitOptions.RemoveEmptyEntries);

		for (int i = 0; i < words.Length; i++)
		{
			if (words[i].Length > 0)
				words[i] = Char.ToUpperInvariant(words[i][0]) + words[i][1..];
		}

		return String.Join(' ', words);
	}
}
