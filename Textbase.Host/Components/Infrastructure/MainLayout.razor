@using Textbase.Application.Features.AuthPrincipals
@using Textbase.Domain.Enumerations
@using Textbase.Host.Authorization
@using Uwn.EntityFrameworkCore.Querying

@inherits LayoutComponentBase
@implements IDisposable

@inject IAuthPrincipalQueries AuthPrincipalQueries
@inject ICurrentPrincipalAccessor CurrentPrincipalAccessor

<CascadingValue Value="this">
	<RadzenLayout>
		<RadzenHeader>
			<RadzenStack AlignItems="AlignItems.Center"
						 Gap="0"
						 Orientation="Orientation.Horizontal">
				<RadzenSidebarToggle Click="@(() => _isSidebarExpanded = !_isSidebarExpanded)" />
				<RadzenLabel Text="@_header" />
			</RadzenStack>
		</RadzenHeader>
		<RadzenSidebar FullHeight="true"
					   @bind-Expanded="@_isSidebarExpanded">
			<RadzenPanelMenu>
				<RadzenPanelMenuItem Icon="@Icons.Home"
									 Path="@StaticRoutes.Home"
									 Text="Home" />
				@if (CanManageApplications)
				{
					<RadzenPanelMenuItem Icon="@Icons.Apps"
										 Path="@StaticRoutes.ClientApplicationList"
										 Text="Applications" />
				}
				<RadzenPanelMenuItem Icon="@Icons._3p"
									 Path="@StaticRoutes.FormalityList"
									 Text="Formalities" />
				<RadzenPanelMenuItem Icon="@Icons.ShortText"
									 Path="@StaticRoutes.PresentationList"
									 Text="Presentations" />
				@if (CanManagePrincipals)
				{
					<RadzenPanelMenuItem Icon="@Icons.ManageAccounts"
										 Path="@StaticRoutes.AuthPrincipalList"
										 Text="Principals">
						<Template>
							<span class="rz-navigation-item-text">Principals</span>
							@if (_pendingPrincipalCount > 0)
							{
								<RadzenBadge BadgeStyle="BadgeStyle.Danger"
											 IsPill="true"
											 Style="margin-inline-start: auto;"
											 Text="@_pendingPrincipalCount.ToString()" />
							}
						</Template>
					</RadzenPanelMenuItem>
				}
			</RadzenPanelMenu>
		</RadzenSidebar>
		<RadzenBody>
			<div class="rz-p-4">
				@if (String.IsNullOrWhiteSpace(_accessDeniedMessage))
				{
					@Body
				}
				else
				{
					<RadzenAlert AlertStyle="AlertStyle.Danger"
								 AllowClose="false"
								 Variant="Variant.Flat">
						@_accessDeniedMessage
					</RadzenAlert>
				}
				@if (AlertService.IsVisible)
				{
					<RadzenAlert AlertStyle="@AlertService.AlertStyle"
								 AllowClose="@AlertService.AllowClose"
								 Size="@AlertService.Size"
								 Title="@AlertService.Title"
								 Variant="@AlertService.Variant"
								 Close="OnAlertClose">
						@((MarkupString)AlertService.HtmlFormattedText)
					</RadzenAlert>
				}
			</div>
		</RadzenBody>
	</RadzenLayout>
</CascadingValue>

<RadzenDialog />

<div id="blazor-error-ui" data-nosnippet>
	An unhandled error has occurred.
	<a href="." class="reload">Reload</a>
	<span class="dismiss">🗙</span>
</div>

@code {
	private string _header = String.Empty;
	private string? _accessDeniedMessage;
	private bool _isSidebarExpanded = true;
	private CurrentPrincipal? _currentPrincipal;
	private long _pendingPrincipalCount;

	private bool CanManageApplications => _currentPrincipal is not null &&
		(_currentPrincipal.RolesValue.HasFlag(Roles.SysAdmin) || _currentPrincipal.RolesValue.HasFlag(Roles.AppAdmin));

	private bool CanManagePrincipals => _currentPrincipal?.RolesValue.HasFlag(Roles.SysAdmin) == true;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		AlertService.OnChange += OnAlertChange;
		NavigationManager.LocationChanged += OnLocationChanged;

		_currentPrincipal = await CurrentPrincipalAccessor.GetAsync();
		await RefreshPendingPrincipalCountAsync();
	}

	public void SetHeader(
		string header)
	{
		if (_header == header)
			return;

		_header = header;

		_ = InvokeAsync(StateHasChanged);
	}

	public void SetAccessDenied(
		string? message)
	{
		if (String.Equals(_accessDeniedMessage, message, StringComparison.Ordinal))
			return;

		_accessDeniedMessage = message;
		_ = InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		AlertService.OnChange -= OnAlertChange;
		NavigationManager.LocationChanged -= OnLocationChanged;
	}

	private async Task RefreshPendingPrincipalCountAsync()
	{
		if (!CanManagePrincipals)
		{
			_pendingPrincipalCount = 0;
			return;
		}

		AuthPrincipalFilter filter = AuthPrincipalFilter.All();
		filter.Status = FilterFactory.CreateNumericFilterFrom<int>((int)PrincipalStatus.Pending);
		_pendingPrincipalCount = await AuthPrincipalQueries.CountAsync(filter);
	}

	private void OnLocationChanged(
		object? sender,
		LocationChangedEventArgs args)
	{
		AlertService.Hide();
		_accessDeniedMessage = null;
		_ = InvokeAsync(RefreshNavigationStateAsync);
	}

	private async Task RefreshNavigationStateAsync()
	{
		await RefreshPendingPrincipalCountAsync();

		StateHasChanged();
	}

	private void OnAlertChange()
		=> _ = InvokeAsync(StateHasChanged);

	private void OnAlertClose(
		dynamic _)
		=> AlertService.Hide();
}
