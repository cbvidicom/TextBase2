@inherits LayoutComponentBase
@implements IDisposable

<CascadingValue Value="this">
	<RadzenLayout>
		<RadzenHeader>
			<RadzenStack AlignItems="AlignItems.Center"
						 Gap="0"
						 Orientation="Orientation.Horizontal">
				<RadzenSidebarToggle Click="@(() => _isSidebarExpanded = !_isSidebarExpanded)" />
				<RadzenLabel Text="@_header" />
			</RadzenStack>
		</RadzenHeader>
		<RadzenSidebar FullHeight="true"
					   @bind-Expanded="@_isSidebarExpanded">
			<RadzenPanelMenu>
				<RadzenPanelMenuItem Icon="@Icons.Home"
									 Path="@StaticRoutes.Home"
									 Text="Home" />
				<RadzenPanelMenuItem Icon="@Icons.Apps"
									 Path="@StaticRoutes.ClientApplicationList"
									 Text="Applications" />
				<RadzenPanelMenuItem Icon="@Icons._3p"
									 Path="@StaticRoutes.FormalityList"
									 Text="Formalities" />
				<RadzenPanelMenuItem Icon="@Icons.ShortText"
									 Path="@StaticRoutes.PresentationList"
									 Text="Presentations" />
			</RadzenPanelMenu>
		</RadzenSidebar>
		<RadzenBody>
			<div class="rz-p-4">
				@Body
			</div>
		</RadzenBody>
	</RadzenLayout>
</CascadingValue>

@if (AlertService.IsVisible)
{
	<RadzenAlert AlertStyle="@AlertService.AlertStyle"
				 AllowClose="@AlertService.AllowClose"
				 Size="@AlertService.Size"
				 Title="@AlertService.Title"
				 Variant="@AlertService.Variant"
				 Close="OnAlertClose">
		@((MarkupString)AlertService.HtmlFormattedText)
	</RadzenAlert>
}

<RadzenDialog />

<div id="blazor-error-ui" data-nosnippet>
	An unhandled error has occurred.
	<a href="." class="reload">Reload</a>
	<span class="dismiss">🗙</span>
</div>

@code {
	private string _header = String.Empty;
	private bool _isSidebarExpanded = true;

	protected override void OnInitialized()
	{
		base.OnInitialized();

		AlertService.OnChange += OnAlertChange;
	}

	public void SetHeader(
		string header)
	{
		if (_header == header)
			return;

		_header = header;

		_ = InvokeAsync(StateHasChanged);
	}

	public void Dispose()
		=> AlertService.OnChange -= OnAlertChange;

	private void OnAlertChange()
		=> _ = InvokeAsync(StateHasChanged);

	private void OnAlertClose(
		dynamic _)
		=> AlertService.Hide();
}
