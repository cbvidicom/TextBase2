@code {
	protected override void OnAfterRender(
		bool firstRender)
	{
		if (!firstRender)
			return;

		string relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
		string redirectUri = String.IsNullOrWhiteSpace(relativePath) ? StaticRoutes.Home : $"/{relativePath}";
		string path = $"{StaticRoutes.SignIn}?redirectUri={Uri.EscapeDataString(redirectUri)}";

		NavigationManager.NavigateTo(path, true);
	}
}
